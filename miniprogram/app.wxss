/* ---------- 底部导航 ---------- */
.tabbar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; height: 116rpx; align-items: center; justify-content: space-around; padding-bottom: 10rpx; border-top: 1rpx solid #efeae1; background: rgba(253, 251, 246, .98); box-shadow: 0 -8rpx 26rpx rgba(120, 108, 90, .04); }
.tab-item { display: flex; min-width: 120rpx; flex-direction: column; align-items: center; gap: 6rpx; color: #a9b1ae; font-size: 20rpx; }
.tab-item.active { color: #7b96b0; }
.tab-item .ic { width: 40rpx; height: 40rpx; background-color: #a9b1ae; }
.tab-item.active .ic { background-color: #7b96b0; }

.stars { position: relative; overflow: hidden; }
.stars::before, .stars::after { position: absolute; content: ""; width: 7rpx; height: 7rpx; border-radius: 50%; background: rgba(255,255,255,.85); box-shadow: 86rpx 45rpx 0 2rpx rgba(255,255,255,.38), 184rpx 13rpx 0 1rpx rgba(255,255,255,.65), 278rpx 72rpx 0 2rpx rgba(255,255,255,.35), 390rpx 28rpx 0 1rpx rgba(255,255,255,.7), 480rpx 95rpx 0 2rpx rgba(255,255,255,.38), 590rpx 35rpx 0 1rpx rgba(255,255,255,.58); animation: breathe 6s ease-in-out infinite alternate; }
.stars::after { top: 100rpx; left: 70rpx; opacity: .65; animation-delay: 1.6s; }
@keyframes breathe { from { opacity: .3; transform: translateY(0); } to { opacity: .9; transform: translateY(-8rpx); } }
