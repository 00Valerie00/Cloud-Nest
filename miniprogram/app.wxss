page {
  min-height: 100%;
  background: #f7f3ec;
  color: #5c6b72;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 30rpx;
  font-weight: 300;
}

view, text, button, input, textarea, picker, image, scroll-view, switch { box-sizing: border-box; }
button { margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; font: inherit; line-height: inherit; }
button::after { border: 0; }

.page { min-height: 100vh; padding: 26rpx 30rpx 70rpx; background: linear-gradient(180deg, #f8f4ee 0%, #f4efe6 100%); }
.home, .mailbox-page, .star-page, .me-page { padding-bottom: 160rpx; }
.eyebrow { color: #a8b0ac; font-size: 21rpx; letter-spacing: 3rpx; }
.title { margin-top: 15rpx; color: #55646b; font-size: 50rpx; font-weight: 400; letter-spacing: 1rpx; }
.subtitle { margin-top: 13rpx; color: #9aa4a1; font-size: 33rpx; line-height: 1.75; }
.card { margin-top: 22rpx; padding: 26rpx; border: 1rpx solid rgba(236, 230, 220, .85); border-radius: 28rpx; background: #fffdf9; box-shadow: 0 10rpx 30rpx rgba(126, 114, 94, .05); }
.row { display: flex; align-items: center; justify-content: space-between; }
.muted { color: #a2aba7; }
.small { font-size: 24rpx; line-height: 1.7; }
.pill { display: inline-flex; align-items: center; padding: 9rpx 20rpx; border-radius: 99rpx; background: #e9eff5; color: #7e96ad; font-size: 22rpx; }
.primary { min-height: 84rpx; padding: 0 34rpx; border-radius: 99rpx; background: #a9bfd4; color: #fff; font-size: 29rpx; letter-spacing: 1rpx; box-shadow: 0 10rpx 24rpx rgba(140, 165, 188, .22); }
.secondary { min-height: 70rpx; padding: 0 26rpx; border: 1rpx solid #e4e0d6; border-radius: 99rpx; background: #fffdf9; color: #84959a; font-size: 26rpx; }
.field { margin-top: 25rpx; }
.field-label { display: block; margin-bottom: 11rpx; color: #7b8a8e; font-size: 25rpx; }
.input, .textarea, .select { width: 100%; padding: 20rpx 24rpx; border: 1rpx solid #ece8df; border-radius: 18rpx; background: #fbf9f4; color: #58666b; font-size: 28rpx; }
.textarea { min-height: 145rpx; line-height: 1.7; }
.divider { height: 1rpx; margin: 20rpx 0; background: #f1ede5; }
.empty { padding: 44rpx 22rpx; color: #9ea6a3; text-align: center; line-height: 1.9; }
.bottom-space { height: 26rpx; }

/* ---------- 线性图标（CSS mask） ---------- */
.ic { display: inline-block; width: 42rpx; height: 42rpx; background-color: #7f9cb8; -webkit-mask: center / contain no-repeat; mask: center / contain no-repeat; flex: none; }
.ic-warm { background-color: #d09a68; }
.ic-soft { background-color: #93a9bd; }
.ic-faint { background-color: #b6c3cf; }
.ic-white { background-color: #fffdf9; }
