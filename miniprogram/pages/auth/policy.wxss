.policy-page { padding-top: 38rpx; }
.policy-card { padding: 34rpx 30rpx; border: 1rpx solid rgba(236, 230, 220, .85); border-radius: 28rpx; background: #fffdf9; box-shadow: 0 10rpx 30rpx rgba(126, 114, 94, .05); }
.policy-title { display: block; margin-bottom: 24rpx; color: #52666d; font-size: 33rpx; font-weight: 600; }
.policy-body { display: block; color: #788783; font-size: 25rpx; line-height: 2; white-space: pre-wrap; }
.policy-footnote { display: block; margin: 20rpx 12rpx; color: #a4ada8; font-size: 20rpx; text-align: center; }
