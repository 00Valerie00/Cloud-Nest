.auth-page { position: relative; display: flex; min-height: 100vh; flex-direction: column; justify-content: center; overflow: hidden; padding: 76rpx 38rpx 48rpx; background: linear-gradient(160deg, #f8f3ea 0%, #f7f3ed 47%, #edf2ef 100%); }
.auth-glow { position: absolute; border-radius: 50%; pointer-events: none; }
.glow-one { top: -250rpx; right: -180rpx; width: 600rpx; height: 600rpx; background: radial-gradient(circle, rgba(222, 207, 178, .32), rgba(222, 207, 178, 0) 70%); }
.glow-two { bottom: -300rpx; left: -220rpx; width: 650rpx; height: 650rpx; background: radial-gradient(circle, rgba(190, 211, 203, .35), rgba(190, 211, 203, 0) 70%); }
.auth-brand { position: relative; display: flex; flex-direction: column; align-items: center; margin-bottom: 42rpx; text-align: center; }
.nest-mark { position: relative; display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; margin-bottom: 20rpx; border: 1rpx solid rgba(180, 157, 120, .25); border-radius: 50%; background: rgba(255, 253, 247, .82); color: #a89170; font-size: 37rpx; box-shadow: 0 12rpx 28rpx rgba(143, 124, 95, .1); }
.nest-mark-dot { position: absolute; right: 12rpx; bottom: 13rpx; width: 11rpx; height: 11rpx; border-radius: 50%; background: #a9c1b3; box-shadow: 0 0 0 5rpx rgba(169, 193, 179, .16); }
.auth-kicker { color: #a8aaa0; font-size: 18rpx; letter-spacing: 4rpx; }
.auth-title { margin-top: 18rpx; color: #53666a; font-size: 39rpx; font-weight: 500; letter-spacing: 1rpx; line-height: 1.45; }
.auth-subtitle { margin-top: 9rpx; color: #99a39d; font-size: 23rpx; letter-spacing: 1rpx; line-height: 1.6; }
.auth-panel { position: relative; padding: 28rpx 28rpx 25rpx; border: 1rpx solid rgba(232, 225, 211, .92); border-radius: 30rpx; background: rgba(255, 253, 249, .93); box-shadow: 0 18rpx 54rpx rgba(105, 117, 112, .09); }
.auth-illustration { display: flex; height: 185rpx; align-items: center; justify-content: center; margin: -6rpx 0 4rpx; }
.auth-illustration image { width: 300rpx; height: 190rpx; }
.panel-title { display: block; color: #61746f; font-size: 27rpx; font-weight: 500; text-align: center; }
.panel-copy { display: block; margin: 12rpx 6rpx 21rpx; color: #929e98; font-size: 21rpx; line-height: 1.75; text-align: center; }
.upgrade-note { display: block; margin: -8rpx 4rpx 18rpx; color: #aa8c6f; font-size: 20rpx; line-height: 1.6; text-align: center; }
.guest-button { display: flex; min-height: 84rpx; align-items: center; justify-content: center; margin-top: 16rpx; border-radius: 22rpx; background: linear-gradient(110deg, #91ad9e, #9ab6a8); color: #fffdf9; font-size: 27rpx; letter-spacing: 1rpx; box-shadow: 0 10rpx 24rpx rgba(127, 158, 141, .2); }
.guest-button[disabled] { opacity: .5; }
.guest-hint { display: block; margin-top: 13rpx; color: #a6afa8; font-size: 18rpx; line-height: 1.6; text-align: center; }
.auth-error { display: block; margin-top: 16rpx; color: #b67d70; font-size: 20rpx; line-height: 1.5; text-align: center; }
.agreement-row { display: flex; align-items: center; justify-content: center; margin-top: 20rpx; }
.agreement-check { display: flex; align-items: center; }
.agreement-copy { display: flex; flex-wrap: wrap; align-items: center; margin-left: 4rpx; color: #99a39d; font-size: 19rpx; line-height: 1.8; }
.agreement-link { color: #738d83; }
.auth-disclaimer { position: relative; display: block; margin: 25rpx 22rpx 0; color: #aab2ac; font-size: 18rpx; line-height: 1.7; text-align: center; }
