.star-page { min-height: 100vh; padding: 32rpx 30rpx 170rpx; overflow: hidden; background: radial-gradient(ellipse at 50% 22%, #203e5d 0%, #172e49 48%, #10253c 100%); color: #eef2ec; }
.nebula-head { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding-top: 4rpx; text-align: center; }
.nebula-eyebrow { color: #8baabd; font-size: 18rpx; letter-spacing: 4rpx; }
.star-alone { margin-top: 8rpx; color: #f3efe4; font-size: 35rpx; letter-spacing: 2rpx; }
.star-desc { max-width: 620rpx; color: #b9c5cd; font-size: 24rpx; line-height: 1.7; }
.globe-stage { position: relative; height: 620rpx; margin: 6rpx -10rpx 0; overflow: hidden; }
.globe-stage::before, .globe-stage::after { position: absolute; z-index: 0; top: 12%; left: 8%; width: 5rpx; height: 5rpx; border-radius: 50%; background: #e4eff2; box-shadow: 90rpx 96rpx 0 1rpx rgba(201, 228, 237, .8), 210rpx 23rpx 0 rgba(255, 255, 255, .8), 350rpx 75rpx 0 1rpx rgba(192, 220, 234, .75), 550rpx 34rpx 0 rgba(255, 255, 255, .8), 620rpx 190rpx 0 1rpx rgba(173, 209, 228, .75), 34rpx 330rpx 0 rgba(255, 255, 255, .65); content: ""; opacity: .6; }
.globe-stage::after { top: 64%; left: 18%; transform: scale(.72); opacity: .38; }
.globe-aura { position: absolute; z-index: 1; top: 50%; left: 50%; width: 640rpx; height: 640rpx; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(circle, rgba(87, 177, 219, .28) 0%, rgba(69, 151, 201, .19) 43%, rgba(50, 127, 182, .08) 65%, rgba(39, 100, 143, 0) 78%); filter: blur(18rpx); }
.globe-zoom-tools { position: absolute; z-index: 4; right: 22rpx; bottom: 58rpx; display: flex; flex-direction: column; gap: 10rpx; }
.globe-zoom-button { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; padding: 0; border: 1rpx solid rgba(190, 225, 240, .36); border-radius: 50%; background: rgba(13, 36, 57, .72); box-shadow: 0 0 20rpx rgba(80, 177, 226, .2); color: #e2f5ff; font-size: 38rpx; font-weight: 300; line-height: 1; }
.orbit { position: absolute; z-index: 2; top: 50%; left: 50%; width: 570rpx; height: 310rpx; transform: translate(-50%, -50%) rotate(-22deg); border: 1rpx solid rgba(150, 202, 223, .2); border-radius: 50%; pointer-events: none; }
.orbit-inner { width: 510rpx; height: 360rpx; transform: translate(-50%, -50%) rotate(58deg); border-color: rgba(169, 191, 229, .14); }
.earth-canvas { position: absolute; z-index: 3; top: 0; left: 0; width: 100%; height: 100%; }
.globe-caption { position: absolute; z-index: 4; right: 0; bottom: 12rpx; left: 0; color: #829ba9; font-size: 19rpx; text-align: center; letter-spacing: 1rpx; pointer-events: none; }
.globe-error { position: absolute; z-index: 5; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80%; padding: 20rpx; border-radius: 20rpx; background: rgba(12, 28, 46, .85); color: #d8e1e2; font-size: 25rpx; text-align: center; }
.globe-tools { display: flex; justify-content: center; gap: 18rpx; margin-top: -4rpx; }
.globe-tool { padding: 11rpx 23rpx; border: 1rpx solid rgba(169, 198, 214, .25); border-radius: 99rpx; background: rgba(232, 241, 242, .06); color: #b6c7d0; font-size: 20rpx; line-height: 1.4; }
.nebula-count-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 30rpx 4rpx 16rpx; }
.nebula-count { display: flex; align-items: baseline; gap: 10rpx; white-space: nowrap; }
.count-number { color: #e8d9b9; font-size: 42rpx; font-weight: 400; }
.count-label { color: #c7d1d1; font-size: 22rpx; }
.count-note { max-width: 350rpx; color: #8196a3; font-size: 19rpx; line-height: 1.5; text-align: right; }
.selected-city { display: flex; align-items: center; gap: 18rpx; margin: 8rpx 0 22rpx; padding: 20rpx 23rpx; border: 1rpx solid rgba(166, 211, 226, .24); border-radius: 22rpx; background: rgba(162, 207, 220, .08); }
.empty-city { border-color: rgba(230, 217, 187, .15); background: rgba(229, 217, 191, .045); }
.selected-orb { flex: none; width: 15rpx; height: 15rpx; border-radius: 50%; background: #a6d9ed; box-shadow: 0 0 22rpx 7rpx rgba(125, 199, 229, .55); }
.selected-copy { display: flex; flex: 1; flex-direction: column; gap: 6rpx; }
.selected-title { color: #e8ece5; font-size: 25rpx; }
.selected-desc { color: #a6b5bc; font-size: 20rpx; line-height: 1.55; }
.selected-close { width: 40rpx; height: 40rpx; color: #91a6b1; font-size: 40rpx; line-height: 38rpx; }
.join-card { margin-top: 20rpx; padding: 27rpx 26rpx 25rpx; border: 1rpx solid rgba(185, 208, 214, .16); border-radius: 28rpx; background: linear-gradient(135deg, rgba(255, 255, 255, .085), rgba(160, 192, 205, .045)); box-shadow: 0 18rpx 42rpx rgba(4, 17, 31, .14); }
.join-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.join-title { color: #f0ede3; font-size: 27rpx; letter-spacing: 1rpx; }
.join-status { color: #b4d4da; font-size: 19rpx; white-space: nowrap; }
.join-copy { display: block; margin-top: 11rpx; color: #a4b5bb; font-size: 21rpx; line-height: 1.65; }
.city-picker { display: flex; align-items: center; justify-content: space-between; height: 76rpx; margin-top: 21rpx; padding: 0 23rpx; border: 1rpx solid rgba(188, 211, 219, .18); border-radius: 17rpx; background: rgba(6, 22, 38, .38); color: #e0e8e4; font-size: 25rpx; }
.location-control { margin-top: 21rpx; overflow: hidden; border: 1rpx solid rgba(188, 211, 219, .18); border-radius: 17rpx; background: rgba(6, 22, 38, .38); }
.location-input-row { display: flex; align-items: center; min-height: 76rpx; }
.location-search { flex: 1; width: 0; height: 76rpx; margin: 0; padding: 0 23rpx; border: 0; background: transparent; color: #e0e8e4; font-size: 24rpx; line-height: 76rpx; }
.location-arrow { display: flex; flex: none; align-items: center; justify-content: center; width: 74rpx; height: 76rpx; color: #8fa8b4; font-size: 30rpx; }
.location-results { width: 100%; max-height: 340rpx; border-top: 1rpx solid rgba(188, 211, 219, .14); background: rgba(9, 28, 46, .96); }
.location-result { display: flex; align-items: center; justify-content: space-between; min-height: 68rpx; padding: 0 22rpx; border-bottom: 1rpx solid rgba(188, 211, 219, .09); color: #e0e8e4; font-size: 23rpx; }
.location-group { color: #8199a5; font-size: 19rpx; }
.picker-arrow { color: #8fa8b4; font-size: 30rpx; }
.consent-row { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 19rpx; color: #a9b8bd; font-size: 20rpx; line-height: 1.65; }
.consent-row checkbox { flex: none; margin-top: -3rpx; transform: scale(.76); transform-origin: left top; }
.join-button { display: flex; align-items: center; justify-content: center; min-height: 76rpx; margin-top: 21rpx; padding: 0 24rpx; border-radius: 99rpx; background: linear-gradient(110deg, #a8c6d1, #91b6c8); color: #203b4f; font-size: 25rpx; line-height: 1.3; letter-spacing: 1rpx; text-align: center; box-shadow: 0 8rpx 22rpx rgba(96, 160, 184, .15); }
.join-disabled { opacity: .52; }
.withdraw-button { min-height: 64rpx; margin-top: 9rpx; color: #b2c3c8; font-size: 21rpx; }
.storage-note { display: block; margin-top: 10rpx; color: #7f939d; font-size: 18rpx; line-height: 1.7; text-align: center; }
.memory-section { margin-top: 38rpx; }
.section-heading { display: flex; flex-direction: column; gap: 7rpx; margin: 0 4rpx 16rpx; }
.section-title { color: #e8e7de; font-size: 28rpx; letter-spacing: 1rpx; }
.section-sub { color: #8fa3ad; font-size: 20rpx; }
.add-memory { display: flex; flex-direction: column; gap: 13rpx; padding: 23rpx; border: 1rpx solid rgba(255, 255, 255, .12); border-radius: 25rpx; background: rgba(255, 253, 247, .07); }
.star-input { width: 100%; min-height: 70rpx; padding: 18rpx 22rpx; border: 1rpx solid rgba(255, 255, 255, .13); border-radius: 16rpx; background: rgba(12, 30, 48, .42); color: #eef0ea; font-size: 24rpx; line-height: 1.6; }
.phrase-input { min-height: 110rpx; }
.star-ph { color: #8195a0; }
.leave-star { display: flex; align-items: center; justify-content: center; min-height: 72rpx; padding: 0 24rpx; border-radius: 99rpx; background: #b6c9d3; color: #344c5d; font-size: 25rpx; line-height: 1.3; letter-spacing: 2rpx; text-align: center; }
.memory-privacy { color: #80949e; font-size: 18rpx; line-height: 1.6; text-align: center; }
.memory-list { display: flex; flex-direction: column; gap: 11rpx; margin-top: 18rpx; }
.memory-item { display: flex; align-items: center; gap: 17rpx; padding: 18rpx 20rpx; border: 1rpx solid rgba(255, 255, 255, .085); border-radius: 19rpx; background: rgba(245, 246, 238, .055); }
.memory-star { flex: none; width: 11rpx; height: 11rpx; border-radius: 50%; background: #f2e2bd; box-shadow: 0 0 15rpx 5rpx rgba(227, 204, 154, .35); }
.memory-copy { display: flex; flex: 1; flex-direction: column; gap: 5rpx; min-width: 0; }
.memory-from { color: #8fa5ae; font-size: 19rpx; }
.memory-phrase { overflow: hidden; color: #d4ddd9; font-size: 21rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.memory-arrow { color: #7d929d; font-size: 33rpx; }
.memory-empty { padding: 28rpx 16rpx; color: #8297a2; font-size: 21rpx; line-height: 1.7; text-align: center; }
