.profile-summary { display: flex; align-items: center; margin-top: 24rpx; padding: 26rpx; border: 1rpx solid #eee9de; border-radius: 30rpx; background: #fffdf9; box-shadow: 0 10rpx 30rpx rgba(126, 114, 94, .05); }
.profile-avatar-stage { flex: none; width: 168rpx; height: 168rpx; overflow: hidden; border: 8rpx solid #f4efe6; border-radius: 50%; background: #f2eee5; }
.profile-avatar { display: block; width: 100%; height: 100%; border-radius: 50%; background: #f2eee5; }
.profile-avatar-stage.cutout-stage { position: relative; overflow: visible; border: 0; background: transparent; }
.profile-avatar-stage.cutout-stage::before { position: absolute; top: 18%; right: 12%; bottom: 12%; left: 12%; border-radius: 50%; background: radial-gradient(circle, rgba(223, 232, 237, .8), rgba(223, 232, 237, 0)); content: ""; }
.profile-avatar.cutout-image { position: relative; z-index: 1; border-radius: 0; background: transparent; filter: drop-shadow(0 8rpx 10rpx rgba(96, 118, 130, .22)); }
.profile-identity { display: flex; flex: 1; flex-direction: column; gap: 10rpx; margin-left: 24rpx; }
.profile-name-row { display: flex; align-items: center; gap: 14rpx; }
.profile-name { color: #4a5a61; font-size: 38rpx; font-weight: 400; }
.name-edit { width: 28rpx; height: 28rpx; }
.dates { letter-spacing: .5rpx; }
.trait-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 6rpx; }
.trait-row .pill { padding: 8rpx 22rpx; font-size: 21rpx; background: #e7edf4; color: #7e96ad; }
.form-card { padding: 26rpx; }
.personality-hint { display: block; margin: 8rpx 0 14rpx; }
.personality-options { display: flex; flex-wrap: wrap; gap: 14rpx; }
.personality-option { padding: 14rpx 26rpx; border: 1rpx solid #e7e2d8; border-radius: 99rpx; background: #fffdf9; color: #87938f; font-size: 24rpx; }
.personality-selected { border-color: #c7d7e5; background: #e8eff5; color: #637d92; box-shadow: inset 0 0 0 1rpx #c7d7e5; }
.fields-row { align-items: flex-start; gap: 15rpx; }.half { width: 50%; }
.avatar-field { margin-top: 26rpx; padding: 22rpx; border: 1rpx solid #eee9de; border-radius: 24rpx; background: #fbf9f4; }
.avatar-field-heading { display: flex; align-items: center; justify-content: space-between; }
.avatar-help { display: block; margin-top: 7rpx; line-height: 1.5; }
.avatar-setting { display: flex; align-items: center; gap: 22rpx; margin-top: 18rpx; }
.avatar-stage { position: relative; display: flex; flex: none; width: 152rpx; height: 152rpx; align-items: center; justify-content: center; overflow: hidden; border: 6rpx solid #f0ece3; border-radius: 50%; background: #f2eee5; }
.avatar-stage.cutout-stage { overflow: visible; border: 0; background: transparent; }
.avatar-stage.cutout-stage::before { position: absolute; top: 14%; right: 8%; bottom: 10%; left: 8%; border-radius: 50%; background: radial-gradient(circle, rgba(220, 231, 237, .82), rgba(220, 231, 237, 0)); content: ""; }
.avatar-stage-image { position: relative; z-index: 1; width: 100%; height: 100%; border-radius: 50%; background: #f2eee5; }
.avatar-stage-image.cutout-image { border-radius: 0; background: transparent; filter: drop-shadow(0 8rpx 10rpx rgba(96, 118, 130, .22)); }
.avatar-controls { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: flex-start; gap: 10rpx; }
.avatar-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }
.avatar-action { min-height: 56rpx; padding: 0 18rpx; border: 1rpx solid #e5e1d8; border-radius: 99rpx; background: #fffdf9; color: #7e8c8d; font-size: 21rpx; line-height: 56rpx; }
.primary-avatar-action { border-color: #dce7ef; background: #e8eff5; color: #6f8798; }
.avatar-clear { padding: 4rpx 8rpx; color: #a98e86; font-size: 20rpx; line-height: 1.4; }
.avatar-tip { display: block; line-height: 1.55; }
.avatar-picker-mask { position: fixed; z-index: 50; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 42rpx; background: rgba(55, 55, 49, .42); backdrop-filter: blur(8px); }
.avatar-picker-dialog { width: 100%; max-height: 76vh; padding: 28rpx; border-radius: 30rpx; background: #faf7f1; box-shadow: 0 22rpx 70rpx rgba(31, 43, 49, .2); }
.avatar-picker-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.avatar-picker-title { color: #52656b; font-size: 28rpx; }
.avatar-picker-close { padding: 0 8rpx; color: #9aa4a1; font-size: 42rpx; line-height: 1; }
.avatar-picker-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.avatar-picker-item { width: calc((100% - 28rpx) / 3); height: 190rpx; overflow: hidden; border-radius: 18rpx; background: #f0ece3; }
.avatar-picker-item image { width: 100%; height: 100%; }
.memory-prompt-section { margin: 26rpx 0 6rpx; padding: 24rpx; border-radius: 24rpx; background: #f6f2ea; }
.section-heading { display: flex; align-items: center; gap: 12rpx; color: #67787c; font-size: 26rpx; }
.sec-ic { width: 30rpx; height: 30rpx; }
.gentle-hint { display: block; margin-top: 9rpx; line-height: 1.6; }
.memory-prompt-card { margin-top: 18rpx; }
.memory-prompt-title { display: block; margin-bottom: 8rpx; color: #7d8a86; font-size: 22rpx; }
.memory-prompt-input { min-height: 68rpx; padding: 0 18rpx; background: #fffdf9; }
.saved-memories-card { margin-top: 20rpx; padding: 26rpx; }
.memory-list-note { display: block; margin-top: 8rpx; line-height: 1.5; }
.memory-empty { padding: 22rpx 0 6rpx; line-height: 1.7; }
.saved-memory-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; padding: 18rpx 0; border-top: 1rpx solid #f1ede5; }
.saved-memory-copy { display: flex; flex: 1; flex-direction: column; gap: 8rpx; }
.saved-memory-source { color: #a2aba7; font-size: 19rpx; }
.saved-memory-content { color: #67757a; font-size: 22rpx; line-height: 1.6; }
.memory-delete { flex: none; padding: 9rpx 8rpx; color: #bd948b; font-size: 20rpx; }
.photos { display: flex; flex-wrap: wrap; gap: 14rpx; }
.photo-item { position: relative; width: 136rpx; height: 136rpx; }
.photo-item image { width: 100%; height: 100%; border-radius: 20rpx; }
.remove { position: absolute; top: -8rpx; right: -8rpx; display: flex; width: 36rpx; height: 36rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(90, 98, 94, .72); color: white; }
.photo-add { display: flex; width: 136rpx; height: 136rpx; flex-direction: column; align-items: center; justify-content: center; gap: 7rpx; border: 1rpx dashed #ddd8cc; border-radius: 20rpx; background: #fbf9f4; color: #a2aba7; font-size: 39rpx; }
.photo-add text { font-size: 21rpx; }
.gentle-note { margin: 24rpx 10rpx; color: #a8b0ac; font-size: 22rpx; line-height: 1.7; text-align: center; }
.save { width: 100%; margin-top: 15rpx; background: #c3d3e2; color: #5c7186; box-shadow: 0 10rpx 24rpx rgba(140, 165, 188, .16); }

/* 修正档案表单输入文字的垂直裁切 */
.form-card .input { height: 80rpx; min-height: 80rpx; padding: 0 24rpx; line-height: 80rpx; }
.form-card .memory-prompt-input { height: 68rpx; min-height: 68rpx; padding: 0 18rpx; line-height: 68rpx; }
