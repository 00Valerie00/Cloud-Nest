.community-page { display: flex; height: 100vh; min-height: 0; flex-direction: column; overflow: hidden; padding-bottom: 26rpx; font-size: 25rpx; }
.community-page .subtitle { font-size: 27rpx; line-height: 1.65; }
.community-page .empty { font-size: 23rpx; line-height: 1.75; }
.community-page .textarea { font-size: 25rpx; }
.filter-row { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 26rpx; }
.filter-pill { padding: 14rpx 30rpx; border: 1rpx solid #e7e2d7; border-radius: 99rpx; background: rgba(255, 253, 249, .9); color: #93a0a3; font-size: 23rpx; }
.filter-pill.active { border-color: #b9cbdc; background: #e2eaf2; color: #6d88a1; }
.quit-row { justify-content: flex-end; margin: 16rpx 6rpx 0; gap: 16rpx; }
.quit { flex: none; color: #a58f85; font-size: 20rpx; }
.joined-content { display: flex; min-height: 0; flex: 1; flex-direction: column; }
.composer-launch { display: flex; flex: none; align-items: center; justify-content: center; min-height: 70rpx; margin-top: 14rpx; border: 1rpx solid #dce5e8; border-radius: 99rpx; background: #fffdf9; color: #71889a; font-size: 23rpx; text-align: center; }
.posts-timeline { min-height: 0; flex: 1; margin-top: 8rpx; }
.post { display: flex; gap: 18rpx; margin-top: 14rpx; padding: 23rpx 25rpx; border-radius: 26rpx; background: #fffdf9; box-shadow: 0 10rpx 28rpx rgba(126, 114, 94, .05); }
.post-avatar { flex: none; width: 78rpx; height: 78rpx; border-radius: 50%; overflow: hidden; background: #eef1f0; }
.post-copy { display: flex; flex: 1; flex-direction: column; gap: 12rpx; }
.post-text { color: #5c6a6e; font-size: 24rpx; line-height: 1.75; white-space: pre-wrap; }
.post-time { color: #b0b8b5; font-size: 18rpx; }
.publish { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 78rpx; margin-top: 14rpx; padding: 0 20rpx; border-radius: 99rpx; background: #c3d3e2; color: #5c7186; font-size: 25rpx; line-height: 1.3; letter-spacing: 1rpx; text-align: center; box-shadow: 0 10rpx 24rpx rgba(140, 165, 188, .16); }
.privacy { flex: none; margin: 12rpx 8rpx 0; color: #a0aaa7; font-size: 18rpx; line-height: 1.55; }
.composer-mask { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; padding: 24rpx; background: rgba(37, 48, 54, .38); }
.composer-sheet { width: 100%; padding: 28rpx; border-radius: 28rpx; background: #fffdf9; box-shadow: 0 12rpx 44rpx rgba(54, 65, 70, .18); }
.composer-heading { display: flex; align-items: center; justify-content: space-between; color: #5c6a6e; font-size: 25rpx; }
.composer-close { padding: 0 8rpx; color: #9aa4a1; font-size: 38rpx; line-height: 1; }
.composer-input { min-height: 220rpx; margin-top: 18rpx; padding: 20rpx; border: 1rpx solid #ece8df; border-radius: 18rpx; background: #fbf9f4; color: #58666b; font-size: 25rpx; line-height: 1.65; }
