.home { padding-top: 34rpx; }
.topline { display: flex; align-items: center; justify-content: space-between; }
.brand-row { display: flex; align-items: center; gap: 12rpx; }
.preview-badge { padding: 5rpx 12rpx; border-radius: 99rpx; background: #e7edf0; color: #8197a1; font-size: 18rpx; }
.profile-switch { padding: 10rpx 20rpx; border: 1rpx solid #eae5da; border-radius: 99rpx; background: rgba(255, 253, 249, .9); color: #8b9a9c; font-size: 24rpx; }
.greet { max-width: 650rpx; margin-top: 38rpx; color: #3e535d; font-family: "STYuanti-SC", "YouYuan", "Hiragino Maru Gothic ProN", "PingFang SC", sans-serif; }
.greet-lead { display: block; color: #7d8d91; font-size: 33rpx; font-weight: 500; line-height: 1.45; letter-spacing: 1rpx; }
.greet-title { display: flex; flex-wrap: wrap; align-items: baseline; margin-top: 8rpx; color: #354c57; font-size: 51rpx; font-weight: 500; line-height: 1.4; letter-spacing: 1rpx; }
.greet-name { display: inline-block; max-width: 100%; margin-right: 10rpx; padding: 0 10rpx 3rpx; border-radius: 12rpx; background: linear-gradient(120deg, #dce8ef 0%, #e7e6f0 100%); color: #6685a0; font-size: 51rpx; font-weight: 500; line-height: 1.35; word-break: break-all; }
.greet-tail { color: #354c57; }
.greet-title-empty { display: block; }
.greet-sub { margin-top: 14rpx; color: #a5aeab; font-size: 26rpx; letter-spacing: 1rpx; }
.pet-card { display: flex; align-items: center; margin-top: 26rpx; padding: 18rpx 22rpx; border: 1rpx solid #eee9de; border-radius: 26rpx; background: rgba(255, 253, 249, .92); box-shadow: 0 8rpx 26rpx rgba(126, 114, 94, .05); }
.pet-photo-stage { position: relative; flex: none; width: 86rpx; height: 86rpx; overflow: hidden; border-radius: 50%; background: #f0ece3; }
.pet-photo { display: block; width: 100%; height: 100%; border-radius: 50%; }
.pet-photo.placeholder { flex: none; width: 86rpx; height: 86rpx; }
.pet-photo-stage.cutout-stage { overflow: visible; background: transparent; }
.pet-photo-stage.cutout-stage::before { position: absolute; top: 12%; right: 8%; bottom: 8%; left: 8%; border-radius: 50%; background: radial-gradient(circle, rgba(220, 231, 237, .8), rgba(220, 231, 237, 0)); content: ""; }
.pet-photo.cutout-image { position: relative; z-index: 1; border-radius: 0; filter: drop-shadow(0 6rpx 8rpx rgba(96, 118, 130, .22)); }
.placeholder { display: flex; align-items: center; justify-content: center; background: #eef1f0; }
.pet-meta { display: flex; flex: 1; flex-direction: column; gap: 7rpx; margin-left: 20rpx; }
.pet-name { color: #51646a; font-size: 29rpx; }
.chevron { width: 30rpx; height: 30rpx; }
.add-card { padding: 24rpx; }
.add-icon { display: flex; width: 78rpx; height: 78rpx; align-items: center; justify-content: center; border-radius: 50%; background: #eef1f0; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 26rpx; }
.g-card { display: flex; width: 48.4%; min-height: 196rpx; flex-direction: column; justify-content: flex-end; margin-bottom: 20rpx; padding: 24rpx 26rpx; border-radius: 28rpx; background: #fffdf9; box-shadow: 0 10rpx 30rpx rgba(126, 114, 94, .06); }
.g-ic { width: 48rpx; height: 48rpx; margin-bottom: auto; }
.warm-ic { width: 50rpx; height: 46rpx; }
.g-title { margin-top: 22rpx; color: #4e5f66; font-size: 29rpx; letter-spacing: .5rpx; }
.g-sub { margin-top: 8rpx; color: #a2aba7; font-size: 21rpx; }
.grid-illust { display: flex; width: 48.4%; min-height: 196rpx; margin-bottom: 20rpx; align-items: flex-end; justify-content: center; }
.grid-illust image { width: 100%; height: 180rpx; }
.me-row { display: flex; align-items: center; margin-top: 6rpx; padding: 24rpx 26rpx; border-radius: 26rpx; background: #fffdf9; box-shadow: 0 10rpx 30rpx rgba(126, 114, 94, .06); }
.me-ic { width: 44rpx; height: 44rpx; }
.me-copy { display: flex; flex: 1; flex-direction: column; gap: 6rpx; margin-left: 20rpx; }
.me-title { color: #51646a; font-size: 29rpx; }
.me-row .ic-chev { width: 28rpx; height: 28rpx; }
.ethics { margin-top: 22rpx; padding: 0 12rpx; color: #a8b0ac; font-size: 20rpx; line-height: 1.7; text-align: center; }
