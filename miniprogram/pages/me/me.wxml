<view class="page me-page">
  <view class="me-head" bindtap="editAccount">
    <image class="me-avatar" src="../../assets/cloud-nest-avatar.png" mode="aspectFill" />
    <view class="me-copy"><text class="me-name">{{accountName || '云间小窝的主人'}}</text><text class="small muted">{{authUser.contact || '已登录'}} · 记录每一份思念</text></view>
    <view class="ic ic-pencil ic-faint"></view>
  </view>
  <view class="section-head row"><text>我的云窝档案</text><button wx:if="{{!guestMode || !pets.length}}" class="add-pet" bindtap="addPet">＋ 新建</button><text wx:else class="guest-limit-note">游客限 1 只</text></view>
  <view class="pet-row" wx:for="{{pets}}" wx:key="id">
    <view class="pet-select" data-id="{{item.id}}" bindtap="selectPet">
      <view wx:if="{{item.avatarDisplay}}" class="pet-avatar-stage {{item.avatarCutout ? 'cutout-stage' : ''}}"><image class="pet-avatar-image {{item.avatarCutout ? 'cutout-image' : ''}}" src="{{item.avatarDisplay}}" mode="{{item.avatarCutout ? 'aspectFit' : 'aspectFill'}}" /></view>
      <view wx:else class="mini-photo"><view class="ic ic-paw ic-faint"></view></view>
      <view class="pet-info"><text class="pet-name">{{item.nickname || item.name}}</text><text class="small muted">{{item.species}} · {{item.archived ? '已安窝封存' : '云窝留存中'}}</text></view>
    </view>
    <button class="archive-btn" data-id="{{item.id}}" data-archived="{{item.archived}}" bindtap="toggleArchive">{{item.archived ? '解封' : '封存'}}</button>
  </view>
  <view wx:if="{{!pets.length}}" class="card empty">还没有档案。留下一份档案，收好你们一起生活的日子。</view>
  <view class="section-head"><text>设置</text></view>
  <view class="settings-card">
    <view class="set-row"><view class="ic ic-mail set-ic"></view><text class="set-name">云间来信</text><switch class="set-switch" checked="{{settings.dailyLetters}}" color="#8fa9c2" bindchange="toggle" data-key="dailyLetters" /></view>
    <view class="set-row"><view class="ic ic-paw set-ic"></view><text class="set-name">同念星云</text><switch class="set-switch" checked="{{settings.starMap}}" color="#8fa9c2" disabled="{{settings.quietMode}}" bindchange="toggle" data-key="starMap" /></view>
    <view class="set-row"><view class="ic ic-people set-ic"></view><text class="set-name">云伴小栈圈子</text><switch class="set-switch" checked="{{settings.community}}" color="#8fa9c2" disabled="{{settings.quietMode}}" bindchange="toggle" data-key="community" /></view>
    <view class="set-row"><view class="ic ic-clock set-ic"></view><text class="set-name">独处安静模式</text><switch class="set-switch" checked="{{settings.quietMode}}" color="#8fa9c2" bindchange="toggleQuiet" /></view>
    <view class="set-row"><view class="ic ic-bell set-ic"></view><text class="set-name">消息推送</text><switch class="set-switch" checked="{{settings.pushEnabled}}" color="#8fa9c2" bindchange="toggle" data-key="pushEnabled" /></view>
  </view>
  <view class="link-card">
    <view class="link-row" bindtap="logout"><text class="link-name">退出登录</text><view class="ic ic-chev ic-faint"></view></view>
    <view class="divider"></view>
    <view class="link-row" bindtap="openSettings"><text class="link-name">设置与隐私说明</text><view class="ic ic-chev ic-faint"></view></view>
    <view class="divider"></view>
    <view class="link-row" bindtap="openWidget"><text class="link-name">云窗 · 桌面样式预览</text><view class="ic ic-chev ic-faint"></view></view>
  </view>
  <view class="support"><text class="support-title">给自己一点时间</text><text class="support-copy">失去陪伴会让人很难过。悲伤没有对错，也不需要赶着好起来。如果难以独自承受，可以向信任的人或专业心理服务寻求支持。</text></view>
  <view class="footer-note">云间小窝是思念记录与 AI 陪伴空间，不是宠物复活，也无法真正与宠物沟通。</view>
  <view wx:if="{{showArchiveDialog}}" class="archive-overlay" bindtap="cancelArchive">
    <view class="archive-dialog" catchtap="holdArchive">
      <text class="archive-title">{{archiveTarget.archived ? '迎它回到小窝？' : '封存档案'}}</text>
      <image class="archive-art" src="../../assets/archive-puppy.png" mode="aspectFit" />
      <text class="archive-copy">{{archiveTarget.archived ? '解封后，这份档案会重新出现在日常小窝中。' : '你可以选择封存这份宠物档案。封存后将停止每日来信推送，但所有档案、照片、对话记录会永久保留，随时可以回来查看、解封。这是一个温柔的阶段性告别，不是删除。'}}</text>
      <view class="archive-actions"><button class="archive-cancel" bindtap="cancelArchive">取消</button><button class="archive-confirm" bindtap="confirmArchive">{{archiveTarget.archived ? '解封' : '封存'}}</button></view>
    </view>
  </view>
</view>
<view class="tabbar">
  <view class="tab-item" bindtap="goHome"><view class="ic ic-home"></view><text>首页</text></view>
  <view class="tab-item" bindtap="goMailbox"><view class="ic ic-mail"></view><text>消息</text></view>
  <view class="tab-item active"><view class="ic ic-user"></view><text>我的</text></view>
</view>
