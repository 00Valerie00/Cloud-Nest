.me-page { padding-top: 34rpx; }
.me-head { display: flex; align-items: center; margin: 8rpx 6rpx 4rpx; }
.me-avatar { flex: none; width: 128rpx; height: 128rpx; border-radius: 50%; border: 5rpx solid rgba(255, 253, 249, .9); background: #f3eee4; box-shadow: 0 8rpx 24rpx rgba(126, 114, 94, .1); }
.me-copy { display: flex; flex: 1; flex-direction: column; gap: 8rpx; margin-left: 24rpx; }
.me-name { color: #4a5a61; font-size: 38rpx; font-weight: 400; }
.me-head .ic-pencil { width: 28rpx; height: 28rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 32rpx 6rpx 14rpx; color: #7b8a8e; font-size: 26rpx; }
.add-pet { padding: 8rpx 20rpx; border-radius: 99rpx; background: #e9eff5; color: #7e96ad; font-size: 21rpx; }
.guest-limit-note { padding: 8rpx 18rpx; border-radius: 99rpx; background: #f2f3ef; color: #9aa6a2; font-size: 20rpx; }
.pet-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 20rpx 24rpx; border-radius: 26rpx; background: #fffdf9; box-shadow: 0 10rpx 28rpx rgba(126, 114, 94, .05); }
.pet-select { display: flex; flex: 1; align-items: center; min-width: 0; }
.pet-avatar-stage, .mini-photo { position: relative; flex: none; width: 84rpx; height: 84rpx; overflow: hidden; border-radius: 50%; background: #eef1f0; }
.pet-avatar-image { display: block; width: 100%; height: 100%; border-radius: 50%; }
.pet-avatar-stage.cutout-stage { overflow: visible; background: transparent; }
.pet-avatar-stage.cutout-stage::before { position: absolute; top: 12%; right: 8%; bottom: 8%; left: 8%; border-radius: 50%; background: radial-gradient(circle, rgba(220, 231, 237, .8), rgba(220, 231, 237, 0)); content: ""; }
.pet-avatar-image.cutout-image { position: relative; z-index: 1; border-radius: 0; filter: drop-shadow(0 6rpx 8rpx rgba(96, 118, 130, .22)); }
.mini-photo { display: flex; align-items: center; justify-content: center; background: #eef1f0; }
.pet-info { display: flex; flex-direction: column; gap: 6rpx; margin-left: 18rpx; }
.pet-name { color: #51646a; font-size: 28rpx; }
.archive-btn { flex: none; padding: 10rpx 24rpx; border-radius: 99rpx; background: #e9eff5; color: #7e96ad; font-size: 22rpx; }
.settings-card { margin-top: 6rpx; padding: 8rpx 26rpx; border: 1rpx solid rgba(236, 230, 220, .85); border-radius: 28rpx; background: #fffdf9; box-shadow: 0 10rpx 30rpx rgba(126, 114, 94, .05); }
.set-row { display: flex; align-items: center; min-height: 100rpx; border-top: 1rpx solid #f3efe7; }
.set-row:first-child { border-top: 0; }
.set-ic { width: 36rpx; height: 36rpx; }
.set-name { flex: 1; margin-left: 20rpx; color: #5c6b72; font-size: 27rpx; }
.set-switch { transform: scale(.8); transform-origin: right center; }
.link-card { margin-top: 20rpx; padding: 6rpx 26rpx; border: 1rpx solid rgba(236, 230, 220, .85); border-radius: 28rpx; background: #fffdf9; box-shadow: 0 10rpx 30rpx rgba(126, 114, 94, .05); }
.link-row { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; }
.link-name { color: #5c6b72; font-size: 27rpx; }
.link-row .ic-chev { width: 26rpx; height: 26rpx; }
.support { display: flex; flex-direction: column; gap: 12rpx; margin-top: 24rpx; padding: 26rpx; border-radius: 28rpx; background: #f1ece1; }
.support-title { color: #7c8582; font-size: 25rpx; }
.support-copy, .footer-note { color: #9aa29e; font-size: 21rpx; line-height: 1.75; }
.footer-note { margin-top: 22rpx; text-align: center; }
.archive-overlay { position: fixed; z-index: 40; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 44rpx; background: rgba(58, 54, 47, .45); backdrop-filter: blur(10px); }
.archive-dialog { display: flex; width: 100%; flex-direction: column; align-items: center; padding: 40rpx 34rpx 30rpx; border-radius: 34rpx; background: #faf7f1; box-shadow: 0 22rpx 70rpx rgba(31, 43, 49, .24); text-align: center; }
.archive-title { color: #4c5d64; font-size: 33rpx; font-weight: 400; letter-spacing: 2rpx; }
.archive-art { width: 340rpx; height: 240rpx; margin-top: 10rpx; }
.archive-copy { margin-top: 6rpx; color: #8e9895; font-size: 24rpx; line-height: 1.85; text-align: left; }
.archive-actions { display: flex; width: 100%; gap: 16rpx; margin-top: 28rpx; }
.archive-actions button { flex: 1; min-height: 82rpx; border: 1rpx solid #e5e1d8; border-radius: 99rpx; background: #fffdf9; color: #7c8a8d; font-size: 26rpx; }
.archive-actions .archive-confirm { border-color: #8ca6bd; background: #8ca6bd; color: #fff; box-shadow: 0 10rpx 22rpx rgba(120, 146, 168, .25); }
