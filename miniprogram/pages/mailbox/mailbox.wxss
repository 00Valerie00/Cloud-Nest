.mailbox-page { display: flex; height: 100vh; min-height: 100vh; flex-direction: column; padding: 20rpx 28rpx 150rpx; }
.note { margin: 4rpx 2rpx 0; color: #aab2ae; font-size: 20rpx; line-height: 1.6; text-align: center; }
.timeline { flex: 1; min-height: 240rpx; margin-top: 14rpx; }
.message { display: flex; width: 100%; align-items: flex-start; gap: 14rpx; margin: 22rpx 0; }
.pet-message { justify-content: flex-start; }.user-message { justify-content: flex-end; }
.message-avatar-stage { position: relative; flex: none; width: 74rpx; height: 74rpx; overflow: hidden; border-radius: 50%; background: #f0eadf; }
.message-avatar { display: block; width: 100%; height: 100%; border-radius: 50%; }
.message-avatar.avatar-fallback { flex: none; width: 74rpx; height: 74rpx; }
.message-avatar-stage.cutout-stage { overflow: visible; background: transparent; }
.message-avatar-stage.cutout-stage::before { position: absolute; top: 12%; right: 8%; bottom: 8%; left: 8%; border-radius: 50%; background: radial-gradient(circle, rgba(220, 231, 237, .8), rgba(220, 231, 237, 0)); content: ""; }
.message-avatar.cutout-image { position: relative; z-index: 1; border-radius: 0; filter: drop-shadow(0 6rpx 8rpx rgba(96, 118, 130, .22)); }
.avatar-fallback { display: flex; align-items: center; justify-content: center; }
.message-bubble { display: flex; max-width: 78%; flex-direction: column; padding: 22rpx 26rpx 18rpx; border-radius: 26rpx; border-top-left-radius: 8rpx; background: #fffdf9; box-shadow: 0 6rpx 22rpx rgba(126, 114, 94, .05); white-space: pre-wrap; }
.user-message .message-bubble { border-radius: 26rpx; border-top-right-radius: 8rpx; background: #dfe7ef; }
.message-text { color: #56646a; font-size: 27rpx; line-height: 1.8; }
.user-message .message-text { color: #5d6e7e; }
.timestamp { margin-top: 12rpx; color: #b4bab5; font-size: 19rpx; text-align: right; }
.empty { display: flex; flex-direction: column; gap: 10rpx; padding-top: 140rpx; color: #a2aba7; text-align: center; }
.pending .message-text { color: #9aabac; }
.composer { display: flex; align-items: flex-end; gap: 14rpx; margin-top: 10rpx; padding: 14rpx 14rpx 14rpx 28rpx; border: 1rpx solid #ece8df; border-radius: 99rpx; background: #fffdf9; box-shadow: 0 8rpx 26rpx rgba(126, 114, 94, .06); }
.compose-input { flex: 1; max-height: 190rpx; min-height: 64rpx; padding: 12rpx 4rpx; color: #58666b; font-size: 26rpx; line-height: 1.6; }
.send { display: flex; flex: none; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; border-radius: 50%; background: #a9bfd4; box-shadow: 0 8rpx 18rpx rgba(140, 165, 188, .28); }
.send-ic { width: 34rpx; height: 34rpx; margin-left: 4rpx; }
.send.disabled { background: #dde2df; box-shadow: none; }
.safety-foot { padding: 12rpx 0 0; text-align: center; font-size: 20rpx; }
