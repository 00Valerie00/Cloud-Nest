.launch { position: relative; display: flex; width: 100%; height: 100vh; overflow: hidden; flex-direction: column; align-items: center; background: #9db1c9; }
.launch-art, .launch-shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.launch-art { object-fit: cover; }
.launch-shade { background: linear-gradient(180deg, rgba(72,96,128,.14) 0%, rgba(90,104,116,.02) 42%, rgba(96,88,80,.05) 100%); }
.launch-copy { position: absolute; z-index: 1; top: 19%; display: flex; width: 100%; flex-direction: column; align-items: center; padding: 0 42rpx; text-align: center; }
.brand { color: #fefcf8; font-family: "Songti SC", "STSong", serif; font-size: 71rpx; font-weight: 400; letter-spacing: 10rpx; text-indent: 10rpx; text-shadow: 0 2rpx 22rpx rgba(74,92,112,.28); }
.brand-swoosh { width: 330rpx; height: 34rpx; margin-top: 14rpx; border-bottom: 2rpx solid rgba(254,251,246,.8); border-radius: 0 0 50% 50% / 0 0 100% 100%; filter: drop-shadow(0 2rpx 10rpx rgba(74,92,112,.18)); }
.slogan { margin-top: 34rpx; color: rgba(255,252,246,.95); font-size: 29rpx; letter-spacing: 3rpx; text-shadow: 0 1rpx 14rpx rgba(74,92,112,.24); }
.description { margin-top: 16rpx; color: rgba(255,252,246,.84); font-size: 25rpx; letter-spacing: 1.5rpx; text-shadow: 0 1rpx 12rpx rgba(74,92,112,.22); }
.enter { position: absolute; z-index: 2; bottom: 15%; display: flex; width: 340rpx; min-height: 84rpx; align-items: center; justify-content: center; background: rgba(255,253,249,.95); color: #6d8296; font-size: 29rpx; letter-spacing: 3rpx; box-shadow: 0 14rpx 34rpx rgba(58,76,92,.18); }
.enter-chevron { margin-left: 14rpx; color: #93a5b4; font-size: 33rpx; }
.notice { position: absolute; z-index: 2; bottom: 5%; width: 84%; color: rgba(255,252,244,.8); font-size: 20rpx; line-height: 1.7; text-align: center; text-shadow: 0 1rpx 10rpx rgba(47,62,71,.25); }
