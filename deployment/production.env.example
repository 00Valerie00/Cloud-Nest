# Set this to a subdomain whose DNS A record points to your server.
API_DOMAIN=api.example.com

# Generate a unique random secret for production. Never reuse the local dev secret.
CLOUD_NEST_AUTH_SECRET=
CLOUD_NEST_DEV_AUTH=0

# Copy the Mini Program AppID from project.config.json; keep AppSecret private.
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=

# Tencent Cloud SMS credentials; required for real phone verification.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
CLOUD_NEST_SMS_APP_ID=
CLOUD_NEST_SMS_SIGN_NAME=
CLOUD_NEST_SMS_TEMPLATE_ID=
CLOUD_NEST_SMS_REGION=ap-guangzhou

# Optional email OTP via SMTP.
CLOUD_NEST_SMTP_HOST=
CLOUD_NEST_SMTP_PORT=465
CLOUD_NEST_SMTP_USERNAME=
CLOUD_NEST_SMTP_PASSWORD=
CLOUD_NEST_EMAIL_FROM=
CLOUD_NEST_SMTP_STARTTLS=0

# Optional AI features.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
